<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>jp.radio-calisthenics-together.caffeinate</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{REPO_DIR}}/.venv/bin/python3</string>
        <string>scripts/caffeinate_with_lock.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>48</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>{{REPO_DIR}}/logs/caffeinate_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO_DIR}}/logs/caffeinate_stderr.log</string>
    <key>WorkingDirectory</key>
    <string>{{REPO_DIR}}</string>
</dict>
</plist>
